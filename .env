EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password

# ⚠️ CRITICAL: Before production deployment:
# 1. Change all PASSWORD fields to strong, unique values
# 2. Update ALLOWED_HOSTS with your actual domain
# 3. Change SECRET_KEY if you prefer a different one
# 4. Update CORS_ALLOWED_ORIGINS with your domain
# 5. Keep this file SECURE - never commit to git!
# 6. Set proper file permissions: chmod 600 .env
