# === APPLICATION ===
APP_VERSION=1.0.0

# === CELERY BEAT SCHEDULER ===
CELERY_BEAT_SCHEDULE_ENABLED=True

# === LOG LEVEL ===
LOG_LEVEL=INFO
ENABLE_FILE_LOGGING=True

# === OPTIONAL: EMAIL CONFIGURATION ===
