# Frontend Configuration - Production

# API Configuration
VITE_API_URL=http://127.0.0.1:8000/api
VITE_API_TIMEOUT=30000
VITE_ENVIRONMENT=production

# App Configuration
VITE_APP_NAME=SGDRA
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Système de Gestion Documentaire avec Routage Automatique

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_SENTRY=true
VITE_ENABLE_WEBSOCKET=true
VITE_DEBUG_MODE=false

# Sentry Configuration
VITE_SENTRY_DSN=https://key@sentry.io/projectid
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# Analytics
VITE_ANALYTICS_ID=UA-XXXXXXXXX-X
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# WebSocket (si utilisé)
VITE_WS_URL=wss://api.sgdra.com/ws

# Features
VITE_MAX_FILE_SIZE=104857600
VITE_ALLOWED_FILE_TYPES=.pdf,.xlsx,.xls,.docx,.doc
VITE_SESSION_TIMEOUT=1800000

# Build Time Variables
VITE_BUILD_TIME=__BUILD_TIME__
VITE_BUILD_VERSION=__BUILD_VERSION__
