# ===== ENVIRONMENT =====
ENVIRONMENT=production
DEBUG=False

# ===== DJANGO =====
SECRET_KEY=your-very-secure-random-key-change-this-in-production
ALLOWED_HOSTS=10.0.5.18,localhost,127.0.0.1,yourdomain.com

# ===== DATABASE =====
MYSQL_ROOT_PASSWORD=sgdra_production_root_secure_2026
MYSQL_DATABASE=sgdra_prod
MYSQL_USER=sgdra_prod_user
MYSQL_PASSWORD=sgdra_prod_password_secure_2026
MYSQL_PORT=3324
DATABASE_URL=mysql://sgdra_prod_user:sgdra_prod_password_secure_2026@mysql:3324/sgdra_prod

# ===== REDIS =====
REDIS_PASSWORD=redis_secure_password
REDIS_URL=redis://:redis_secure_password@redis:6379/0
REDIS_PORT=6379
CELERY_BROKER_URL=redis://:redis_secure_password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:redis_secure_password@redis:6379/1

# ===== BACKEND =====
BACKEND_PORT=8000

# ===== FRONTEND =====
FRONTEND_PORT=5173

# ===== SECURITY =====
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=True
SESSION_COOKIE_HTTPONLY=True

# ===== CORS =====
CORS_ALLOWED_ORIGINS=https://10.0.5.18,https://yourdomain.com

# ===== EMAIL =====
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password

# ===== SENTRY (Error Tracking) =====
SENTRY_ENABLED=False
SENTRY_DSN=

# ===== APP =====
SITE_URL=https://10.0.5.18
APP_VERSION=1.0.0

# ===== RATE LIMITING =====
ANON_THROTTLE_RATE=100/hour
USER_THROTTLE_RATE=1000/hour

# ===== PAGINATION =====
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100

# ===== TIMEZONE =====
TZ=Africa/Lagos
