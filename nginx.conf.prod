upstream backend {
    server backend:8000;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 100M;

    # API endpoints - FIRST (before static, to avoid conflicts)
    location /api/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Admin interface
    location /admin/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Assets folder (no-cache for accuracy)
    location /static/frontend/assets/ {
        alias /srv/sgdra/frontend/dist/assets/;
        expires 30d;
        add_header Cache-Control "public";
    }

    # Images folder
    location /static/frontend/images/ {
        alias /srv/sgdra/frontend/dist/images/;
        expires 30d;
    }

    # SVG and icon assets
    location ~ \.(svg|ico)$ {
        alias /srv/sgdra/frontend/dist/$request_filename;
        expires 7d;
    }

    # Frontend HTML - always fresh
    location ~ \.html$ {
        alias /srv/sgdra/frontend/dist/$request_filename;
        add_header Cache-Control "no-cache, max-age=0";
    }

    # Fallback for static frontend
    location /static/frontend/ {
        alias /srv/sgdra/frontend/dist/;
    }

    # Health check
    location /health {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type "text/plain";
    }

    # Default - SPA routing (serve index.html for all routes)
    location / {
        alias /srv/sgdra/frontend/dist/;
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
