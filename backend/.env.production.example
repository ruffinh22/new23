# .env.production.example
# Production Environment Configuration
# Copy this file to backend/.env and fill in all values
# IMPORTANT: Never commit actual .env files to git!

# ===========================
# 🔐 DJANGO - CRITICAL SECURITY
# ===========================
# Generate a new secret key BEFORE production:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-generated-secret-key-here-min-50-chars

# NEVER set to True in production
DEBUG=False

# Your production domains (comma-separated, no spaces)
ALLOWED_HOSTS=www.sgdra.example.com,sgdra.example.com,api.sgdra.example.com

# Environment identifier
ENVIRONMENT=production

# ===========================
# 🗄️ DATABASE - STRONGLY SECURE
# ===========================
# Use strong, randomly generated passwords (min 20 chars)
# Generate: openssl rand -base64 32

DATABASE_URL=mysql://sgdra_prod:your-strong-db-password@mysql:3306/sgdra_prod_db
MYSQL_DATABASE=sgdra_prod_db
MYSQL_USER=sgdra_prod
MYSQL_PASSWORD=your-strong-db-password-min-20-chars
MYSQL_ROOT_PASSWORD=your-strong-root-password-min-20-chars

# Database connection pool
DB_POOL_SIZE=20
DB_POOL_RECYCLE=3600

# ===========================
# 💾 REDIS & CELERY
# ===========================
REDIS_URL=redis://:your-redis-password@redis:6379/0
CELERY_BROKER_URL=redis://:your-redis-password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:your-redis-password@redis:6379/1

# Celery settings
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540
CELERY_BEAT_SCHEDULE_ENABLED=True

# ===========================
# 🔒 HTTPS & SECURITY
# ===========================
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Cookie security
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Strict
CSRF_COOKIE_SAMESITE=Strict
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_SECURITY_POLICY=True
X_FRAME_OPTIONS=DENY

# ===========================
# 🌐 CORS - Frontend Domains
# ===========================
CORS_ALLOWED_ORIGINS=https://www.sgdra.example.com,https://sgdra.example.com,https://api.sgdra.example.com
CORS_ALLOW_CREDENTIALS=True

# ===========================
# 🔑 JWT AUTHENTICATION
# ===========================
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================
# 📧 EMAIL NOTIFICATIONS
# ===========================
# Gmail: https://myaccount.google.com/apppasswords
# Office 365: use App Password
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@sgdra.example.com

# Test email (will be used for test_mail command)
TEST_EMAIL_RECIPIENT=admin@example.com

# ===========================
# 💾 FILE STORAGE
# ===========================
# Local storage or AWS S3
USE_S3=False

# For local storage
MEDIA_ROOT=/app/backend/media
MEDIA_URL=/media/

# For AWS S3 (set USE_S3=True)
# Generate keys: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=sgdra-documents-production
AWS_S3_REGION_NAME=eu-west-1
AWS_S3_CUSTOM_DOMAIN=d1234567890.cloudfront.net
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_QUERYSTRING_AUTH=False

# ===========================
# 📊 LOGGING & MONITORING
# ===========================
LOG_LEVEL=INFO
LOG_DIR=logs
ENABLE_FILE_LOGGING=True

# For Sentry error tracking: https://sentry.io
ENABLE_SENTRY=True
SENTRY_DSN=https://key@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ===========================
# 📤 FILE UPLOAD LIMITS
# ===========================
MAX_UPLOAD_SIZE_MB=100
DATA_UPLOAD_MAX_MEMORY_SIZE=104857600  # 100MB
FILE_UPLOAD_MAX_MEMORY_SIZE=104857600  # 100MB
FILE_UPLOAD_TEMP_DIR=/tmp

# ===========================
# ⏱️ TIMEOUT SETTINGS
# ===========================
REQUEST_TIMEOUT_SECONDS=300
CELERY_TASK_TIME_LIMIT=600

# ===========================
# 🚦 RATE LIMITING
# ===========================
ENABLE_RATE_LIMITING=True
RATELIMIT_ANONYMOUS_REQUESTS_PER_HOUR=100
RATELIMIT_AUTHENTICATED_REQUESTS_PER_HOUR=1000
RATELIMIT_ADMIN_REQUESTS_PER_HOUR=5000

# ===========================
# 🔔 NOTIFICATIONS
# ===========================
SEND_EMAIL_NOTIFICATIONS=True
SEND_SYSTEM_NOTIFICATIONS=True
NOTIFICATION_RETENTION_DAYS=90

# ===========================
# 📈 PERFORMANCE
# ===========================
CACHE_TIMEOUT_SECONDS=3600
SESSION_TIMEOUT_SECONDS=86400  # 24 hours
DATABASE_CONN_MAX_AGE=600

# Use Gunicorn workers (production)
# Formula: (2 × CPU cores) + 1
# For 4 cores: 9 workers
WORKERS=9
WORKER_CLASS=sync
WORKER_CONNECTIONS=1000
KEEP_ALIVE=5
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100

# ===========================
# 🛡️ BACKUP & DISASTER RECOVERY
# ===========================
BACKUP_ENABLED=True
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/backups

# ===========================
# 📱 MOBILE/API SETTINGS
# ===========================
API_THROTTLE_ANON_RATE=100/hour
API_THROTTLE_USER_RATE=1000/hour
API_PAGE_SIZE=50
API_VERSION=v1

# ===========================
# 🌍 INTERNATIONALIZATION
# ===========================
LANGUAGE_CODE=en-us
TIME_ZONE=UTC
USE_I18N=True
USE_TZ=True

# ===========================
# 📦 VERSION INFO
# ===========================
APP_VERSION=1.0.0
APP_NAME=SGDRA
APP_DESCRIPTION=Système de Gestion des Documents avec Routage Automatique

# ===========================
# 🔗 EXTERNAL SERVICES (Optional)
# ===========================
# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Slack Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_NOTIFICATIONS_ENABLED=False

# DataDog (optional)
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key

# ===========================
# ⚡ DEVELOPMENT/DEBUG (Secret: False in production!)
# ===========================
# Only for troubleshooting - set to False normally
SHOW_QUERY_LOGS=False
TRACE_REQUESTS=False
PROFILE_REQUESTS=False
