# ===========================
# CONFIGURATION DJANGO - CRITIQUE
# ===========================
# En production: générer avec: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-insecure-secret-key-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,api.example.com
ENVIRONMENT=development

# ===========================
# BASE DE DONNÉES - PostgreSQL
# ===========================
# Format: postgresql://username:password@host:port/dbname
DATABASE_URL=postgresql://sgdra_user:sgdra_password@localhost:5432/sgdra_db

# Fallback (si DATABASE_URL pas disponible)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=sgdra_db
DB_USER=sgdra_user
DB_PASSWORD=sgdra_password
DB_HOST=localhost
DB_PORT=5432

# ===========================
# REDIS & CELERY
# ===========================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ===========================
# SÉCURITÉ HTTPS & COOKIES (production only)
# ===========================
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=True

# ===========================
# CORS - Spécifier les domaines du frontend
# ===========================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://sgdra.example.com
CORS_ALLOW_CREDENTIALS=True

# ===========================
# JWT AUTHENTIFICATION
# ===========================
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================
# EMAIL - Notifications
# ===========================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@sgdra.example.com

# ===========================
# STOCKAGE FICHIERS
# ===========================
# LOCAL (développement) ou S3 (production)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=sgdra-documents
AWS_S3_REGION_NAME=eu-west-1

# ===========================
# LOGGING & MONITORING
# ===========================
LOG_LEVEL=INFO
LOG_DIR=logs
ENABLE_FILE_LOGGING=True
ENABLE_SENTRY=False
SENTRY_DSN=

# ===========================
# LIMITES & TIMEOUTS
# ===========================
MAX_UPLOAD_SIZE_MB=50
DATA_UPLOAD_MAX_MEMORY_SIZE=52428800
FILE_UPLOAD_MAX_MEMORY_SIZE=52428800
REQUEST_TIMEOUT_SECONDS=300
CELERY_TASK_TIME_LIMIT=600

# ===========================
# RATE LIMITING
# ===========================
RATELIMIT_ANONYMOUS_REQUESTS_PER_HOUR=100
RATELIMIT_AUTHENTICATED_REQUESTS_PER_HOUR=1000
ENABLE_RATE_LIMITING=True

# ===========================
# PAGINATION
# ===========================
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100
