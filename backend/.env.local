# =====================================================
# SGDRA LOCAL DEVELOPMENT CONFIGURATION
# =====================================================
# LOCAL DEVELOPMENT - NOT FOR PRODUCTION

# === DJANGO CONFIGURATION ===
DEBUG=True
ENVIRONMENT=development
SECRET_KEY=dev-key-for-local-development-only-change-in-production-12345
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# === DATABASE CONFIGURATION (Local MySQL) ===
DATABASE_URL=mysql://sgdra_dev:sgdra_dev_password@_26R@127.0.0.1:3306/sgdra_dev

# === REDIS CONFIGURATION (Local) ===
REDIS_PASSWORD=redis_dev_password
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# === BACKEND PORT ===
BACKEND_PORT=8003

# === SECURITY SETTINGS (Development) ===
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_HTTPONLY=True
SESSION_COOKIE_HTTPONLY=True

# === CORS & API SETTINGS ===
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8003,http://127.0.0.1:5173

# === SENTRY ERROR TRACKING (Disabled) ===
SENTRY_DSN=
SENTRY_ENABLED=False

# === APPLICATION ===
APP_VERSION=1.0.0-dev

# === CELERY BEAT SCHEDULER ===
CELERY_BEAT_SCHEDULE_ENABLED=True

# === LOG LEVEL ===
LOG_LEVEL=DEBUG
ENABLE_FILE_LOGGING=True

# === EMAIL CONFIGURATION (Console Backend) ===
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=dev@example.com
EMAIL_HOST_PASSWORD=dev-password

# === TIMEZONE ===
TZ=Africa/Lagos

# === RATE LIMITING ===
ANON_THROTTLE_RATE=100/hour
USER_THROTTLE_RATE=1000/hour

# === PAGINATION ===
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100

# === SITE CONFIGURATION ===
SITE_URL=http://localhost:8003
